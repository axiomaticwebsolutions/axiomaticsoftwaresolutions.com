# Production environment of the Axiomatic app on the aaPanel server (deploy/README.md). TEST-MODE release:
# Razorpay test keys, real SMTP, a real private S3-compatible bucket.
#
# Never copy or edit this example in place. Generate the real file ON THE SERVER, with fresh secrets:
#   node scripts/gen-prod-env.mjs --out /www/wwwroot/axiomatic/shared/.env.production
# then edit that file (aaPanel > Files, or nano) and replace every value that still contains CHANGE-ME. deploy.sh
# refuses to deploy while one is left (deploy/preflight.mjs), and lib/env.ts refuses placeholder secrets.
# The real file: chmod 600, owned by the app user, never committed, never pasted into chat, email or a ticket.
# Keep a copy in your password manager: LICENSE_KEY_PEPPER and LICENSE_KEY_ENC_KEY cannot be recreated.
#
# Format: read by Next.js through @next/env (dotenv + dotenv-expand), like .env.local in development.
# - One KEY=value per line. Wrap a value in double quotes when it contains spaces or "#".
# - A "$" starts a variable reference: write a literal dollar sign as \$ (simpler: avoid "$" in passwords).
# - NODE_ENV is not set here: next build, next start (PM2, deploy/ecosystem.config.cjs) and deploy.sh set it.
# After editing: bash /www/wwwroot/axiomatic/current/deploy/restart.sh (as the app user). STORAGE_* changes need a
# new deploy instead: next build bakes the bucket address into the Content-Security-Policy.

# ---- App
# The exact address in the browser: https, no trailing slash, the bare domain (Nginx redirects www to it). Sign-in
# and every form compare it with the browser's Origin header.
APP_URL=https://CHANGE-ME-your-domain.com
# HMAC keys (generated). Rotating SESSION_SECRET forgets "trusted devices" and voids sign-in codes in flight;
# CSRF_SECRET makes open forms fail once (reload); ORDER_TOKEN_SECRET breaks guest order links already emailed.
SESSION_SECRET=change-me-run-gen-prod-env
CSRF_SECRET=change-me-run-gen-prod-env
ORDER_TOKEN_SECRET=change-me-run-gen-prod-env
# Bearer token for /api/cron/* (generated). deploy/cron-*.sh read it from this file on every run.
CRON_SECRET=change-me-run-gen-prod-env

# ---- Database: PostgreSQL 14+ on this server, listening on localhost only, database created UTF8 (deploy/db-setup.sh).
# The password is generated with letters and digits only; any other character would need URL percent-encoding.
# No ?schema= on a production URL (docs/scaling.md).
DATABASE_URL=postgresql://axiomatic:CHANGE-ME-DB-PASSWORD@127.0.0.1:5432/axiomatic
# Pool per app process (docs/scaling.md "Connection pooling"). Processes x DATABASE_POOL_MAX must stay well below
# PostgreSQL max_connections (100 by default): 1-4 PM2 instances x 10 is fine.
DATABASE_POOL_MAX=10
DATABASE_POOL_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=5000
# The storefront reads the catalog from the database (fixtures are refused in production).
CATALOG_SOURCE=db

# ---- Licensing (generated). PEPPER and ENC_KEY are permanent once a license key exists: changing them makes issued
# keys unverifiable and unrevealable. The signing pair is permanent too: desktop apps embed the PUBLIC key (it is
# public; send LICENSE_SIGNING_PUBLIC_KEY to the app developers) and only accept tokens signed by its private key.
LICENSE_KEY_PEPPER=change-me-run-gen-prod-env
LICENSE_KEY_ENC_KEY=change-me-run-gen-prod-env
LICENSE_SIGNING_PRIVATE_KEY=change-me-run-gen-prod-env
LICENSE_SIGNING_PUBLIC_KEY=change-me-run-gen-prod-env
LICENSE_OFFLINE_GRACE_DAYS=7

# ---- Payments: Razorpay in TEST mode (Dashboard > Test Mode > Account & Settings > API Keys > Generate Test Key).
# Going live later = rzp_live_ keys + a new webhook secret (docs/go-live-checklist.md).
PAYMENT_PROVIDER=razorpay
PAYMENT_KEY_ID=rzp_test_CHANGE-ME
PAYMENT_KEY_SECRET=CHANGE-ME
# Generated. Paste the same value as the "Secret" of the Razorpay webhook (Test Mode > Webhooks > Add New Webhook,
# URL https://<domain>/api/webhooks/payments/razorpay, events payment.captured, order.paid, payment.failed,
# refund.processed, refund.failed).
PAYMENT_WEBHOOK_SECRET=change-me-run-gen-prod-env

# ---- Private file storage: an S3-compatible bucket with ALL public access blocked (deploy/README.md "Storage").
#   AWS S3 Mumbai:          STORAGE_ENDPOINT=https://s3.ap-south-1.amazonaws.com  STORAGE_REGION=ap-south-1  path style false
#   Cloudflare R2:          STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com  STORAGE_REGION=auto  path style true
#   DigitalOcean Spaces:    STORAGE_ENDPOINT=https://blr1.digitaloceanspaces.com  STORAGE_REGION=blr1  path style false
# The bucket needs CORS allowing PUT, GET and HEAD from APP_URL with the content-type header. next build bakes the
# bucket origin into the Content-Security-Policy: deploy again after changing any STORAGE_* value.
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=https://s3.ap-south-1.amazonaws.com
STORAGE_REGION=ap-south-1
STORAGE_BUCKET=change-me-bucket-name
STORAGE_ACCESS_KEY_ID=CHANGE-ME
STORAGE_SECRET_ACCESS_KEY=CHANGE-ME
STORAGE_FORCE_PATH_STYLE=false
# Presigned download links live at most 600 s whatever this says.
DOWNLOAD_LINK_TTL_SECONDS=600

# ---- Email by SMTP: sign-in codes, order, license and ticket emails. Staff sign in with an emailed code, so SMTP must
# work before the first sign-in. Port 587 (STARTTLS, enforced in production) or 465 (implicit TLS). EMAIL_FROM must
# use a domain verified with the provider (SPF + DKIM).
EMAIL_TRANSPORT=smtp
EMAIL_FROM="Axiomatic Software <no-reply@CHANGE-ME-your-domain.com>"
SMTP_HOST=CHANGE-ME-smtp-host
SMTP_PORT=587
SMTP_USER=CHANGE-ME
SMTP_PASSWORD=CHANGE-ME

# ---- Rate limits (required in production): Redis on this server, bound to 127.0.0.1, with `requirepass` set to the
# password inside this URL (generated, letters and digits only). Database 0.
REDIS_URL=redis://:CHANGE-ME-REDIS-PASSWORD@127.0.0.1:6379/0
# Proxies in front of the app that append to X-Forwarded-For: aaPanel's Nginx = 1. Only behind one more proxy (e.g.
# Cloudflare's orange cloud) use 2, and then accept origin traffic from that proxy's addresses only.
TRUSTED_PROXY_HOPS=1

# ---- Security headers. While this is false, HSTS is max-age=31536000 (one year, this host only). Set it to true before
# live sales, once EVERY subdomain of the domain serves HTTPS: it adds includeSubDomains; preload (browsers then refuse
# plain HTTP on all of them for a year, and the preload list is slow to leave). Read by `next build`, so a change needs
# a deploy (deploy.sh), not just a restart.
SECURITY_HSTS_STRICT=false

# ---- First deploy only: deploy.sh --first-run runs scripts/bootstrap-production.ts, which creates the catalog,
# settings and the first Owner (two-step sign-in by email). BOOTSTRAP_OWNER_EMAIL must be a mailbox you read. The
# password is generated: read it here, sign in at https://<domain>/sign-in, then DELETE both BOOTSTRAP_OWNER_* lines
# (never needed again; the bootstrap never resets a password). Instead of keeping the password in this file you may
# delete its line and export BOOTSTRAP_OWNER_PASSWORD in the shell for the first deploy only.
BOOTSTRAP_OWNER_EMAIL=CHANGE-ME@your-domain.com
BOOTSTRAP_OWNER_PASSWORD=change-me-run-gen-prod-env
# BOOTSTRAP_OWNER_NAME="Your Name"
# Optional seller details for the first run; without them the SAMPLE placeholders are used and the site keeps its
# sample label. Edit them later in Admin > Settings either way.
# BOOTSTRAP_BUSINESS_LEGAL_NAME=
# BOOTSTRAP_BUSINESS_GSTIN=
# BOOTSTRAP_BUSINESS_ADDRESS=
# BOOTSTRAP_BUSINESS_CITY=
# BOOTSTRAP_BUSINESS_STATE=
# BOOTSTRAP_BUSINESS_PIN=
# BOOTSTRAP_BUSINESS_PHONE=
# BOOTSTRAP_BUSINESS_HOURS=
# BOOTSTRAP_SUPPORT_EMAIL=
# BOOTSTRAP_SALES_EMAIL=
# BOOTSTRAP_LEGAL_EMAIL=
# BOOTSTRAP_PRIVACY_EMAIL=
