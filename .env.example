# Copy to .env.local with `pnpm secrets` (generates fresh dev secrets). Never commit real values.
# Values marked change-me / xxxxxxxx are placeholders: lib/env.ts refuses to start with them.

# ---- App
APP_URL=http://localhost:3000
NODE_ENV=development
SESSION_SECRET=change-me-64-random-bytes            # HMAC for signed cookies (guest order access, flash state)
CSRF_SECRET=change-me                               # HMAC for the double-submit CSRF token
ORDER_TOKEN_SECRET=change-me                        # HMAC for guest order links (/orders/[id]?t=...)
CRON_SECRET=change-me                               # bearer token for /api/cron/* (reconciliation job)

# ---- Database
DATABASE_URL=postgresql://axiomatic:axiomatic@localhost:5432/axiomatic?schema=public
TEST_DATABASE_URL=postgresql://axiomatic:axiomatic@localhost:5432/axiomatic_test?schema=public
# PRISMA_LOG_QUERIES=1                               # dev only: logs every SQL query, parameters included
# Pool bounds per app process (docs/scaling.md "Connection pooling"). A request waits at most DATABASE_POOL_TIMEOUT_MS
# for a connection and a statement runs at most DATABASE_STATEMENT_TIMEOUT_MS; past either the API answers 503
# "unavailable" with Retry-After (load shedding). Set the statement timeout to 0 behind PgBouncer (set it on the role).
# DATABASE_POOL_MAX=10
# DATABASE_POOL_TIMEOUT_MS=5000
# DATABASE_STATEMENT_TIMEOUT_MS=5000
# Storefront catalog source: db | fixtures (serves prisma/seed-data without a database; dev/test only, refused in
# production)
CATALOG_SOURCE=db

# ---- Licensing (generate fresh values; never commit real ones; PEPPER is immutable once keys exist)
LICENSE_KEY_PEPPER=change-me-32-bytes-hex             # HMAC for keyHash lookups
LICENSE_KEY_ENC_KEY=change-me-32-bytes-base64         # AES-256-GCM for authorized key reveal
LICENSE_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"   # Ed25519, activation tokens
LICENSE_SIGNING_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
LICENSE_OFFLINE_GRACE_DAYS=7

# ---- Payments, storage and email: in production these are normally saved in Admin > Settings > Integrations
# (docs/admin-integrations-design.md); the values below are only the fallback while nothing is saved there. Unset
# selectors mean the development drivers (mock, local, console) outside production and "not configured" in it.

# ---- Payments (India-focused provider via adapter)
PAYMENT_PROVIDER=mock                                 # razorpay | cashfree | mock (mock is refused in production)
PAYMENT_KEY_ID=rzp_test_xxxxxxxx
PAYMENT_KEY_SECRET=xxxxxxxx
PAYMENT_WEBHOOK_SECRET=xxxxxxxx

# ---- Protected file storage
STORAGE_DRIVER=local                                  # local (dev only, signed URLs served by the app) | s3
STORAGE_LOCAL_DIR=.storage
STORAGE_ENDPOINT=https://s3.ap-south-1.amazonaws.com
STORAGE_REGION=ap-south-1
STORAGE_BUCKET=axiomatic-installers
STORAGE_ACCESS_KEY_ID=xxxxxxxx
STORAGE_SECRET_ACCESS_KEY=xxxxxxxx
STORAGE_FORCE_PATH_STYLE=false                        # true for MinIO / some S3-compatible stores
DOWNLOAD_LINK_TTL_SECONDS=600

# ---- Email
EMAIL_TRANSPORT=console                               # console (dev: prints to the server log) | smtp | ses
EMAIL_FROM="Axiomatic Software <no-reply@axiomatic.example>"
SMTP_HOST=localhost
SMTP_PORT=1025                                        # e.g. Mailpit in dev
SMTP_USER=
SMTP_PASSWORD=
# Amazon SES API (EMAIL_TRANSPORT=ses): region (no endpoint), an IAM user's key with ses:SendEmail and ses:SendRawEmail
# on the sending identity only (policy: docs/go-live-checklist.md).
# SES_REGION=ap-south-1
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=
# SES_CONFIGURATION_SET=

# ---- Rate limiting: optional in development (falls back to Postgres buckets); REQUIRED when NODE_ENV=production
REDIS_URL=
# Proxies that append to X-Forwarded-For in front of the app (ALB = 1, CloudFront + ALB = 2).
# 0 = trust no forwarding header (client IP unknown; fine for local dev). Required and >= 1 in production.
TRUSTED_PROXY_HOPS=0

# ---- Seed (dev only; the seed refuses to run when NODE_ENV=production)
SEED_OWNER_EMAIL=owner@axiomatic.example
SEED_OWNER_PASSWORD=change-me
SEED_DEMO_PASSWORD=change-me                          # shared password for the SAMPLE demo logins (Priya, Vikram, Sneha, Karan)

# ---- Security headers
# HSTS is max-age=31536000 by default (the test release). Set SECURITY_HSTS_STRICT=1 to add includeSubDomains; preload,
# only once EVERY subdomain of the domain serves HTTPS (browsers then refuse plain HTTP on all of them for a year and
# the preload list is slow to leave). Turn it on before live sales. Baked in by `next build`: rebuild after changing it.
# SECURITY_HSTS_STRICT=1

# ---- Production bootstrap (scripts/bootstrap-production.ts, `pnpm bootstrap:prod`; production only, never needed locally)
# Creates the catalog, settings, counters and the first Owner in an EMPTY production database (no demo data). The
# OWNER lines are required only while no Owner exists: export them in the shell for that one run (or keep them in
# shared/.env.production until the first sign-in), then delete them. The password is never printed or stored in plain
# text. The business lines are optional and used only when those settings are first created (else SAMPLE
# placeholders that the Owner edits in Admin > Settings). See deploy/README.md and docs/deploy-today.md.
# BOOTSTRAP_OWNER_EMAIL=you@yourdomain.in                # a mailbox you read: password resets (and sign-in codes, once two-step is on) go here
# BOOTSTRAP_OWNER_PASSWORD=                             # 8+ characters with a letter and a number; no $, #, quotes or spaces
# BOOTSTRAP_OWNER_NAME="Your Name"
# BOOTSTRAP_BUSINESS_LEGAL_NAME="Your Company Pvt. Ltd."
# BOOTSTRAP_BUSINESS_GSTIN=
# BOOTSTRAP_BUSINESS_ADDRESS=
# BOOTSTRAP_BUSINESS_CITY=
# BOOTSTRAP_BUSINESS_STATE=
# BOOTSTRAP_BUSINESS_PIN=
# BOOTSTRAP_BUSINESS_PHONE=
# BOOTSTRAP_BUSINESS_HOURS=
# BOOTSTRAP_SUPPORT_EMAIL=
# BOOTSTRAP_SALES_EMAIL=
# BOOTSTRAP_LEGAL_EMAIL=
# BOOTSTRAP_PRIVACY_EMAIL=
# BOOTSTRAP_BUSINESS_SAMPLE=true                        # false once the business details above are real
# BOOTSTRAP_SAMPLE_NOTICE_TEXT=                         # overrides the storefront sample-notice text
