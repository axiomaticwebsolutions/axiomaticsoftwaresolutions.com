{
  "name": "axiomaticsoftwaresolutions.com",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "check:all": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm test:db",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force && prisma db seed",
    "secrets": "tsx scripts/gen-secrets.ts",
    "icons": "tsx scripts/gen-icons.ts",
    "db:dev": "node scripts/dev-db.mjs",
    "storage:seed": "node scripts/storage-seed.mjs",
    "bench:validate": "node scripts/bench-validate.mjs",
    "env:prod": "node scripts/gen-prod-env.mjs",
    "bootstrap:prod": "tsx scripts/bootstrap-production.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/client-sesv2": "3.1146.0",
    "@aws-sdk/s3-request-presigner": "3.1146.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@next/env": "15.5.27",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-pdf/renderer": "4.9.0",
    "@tanstack/react-table": "8.21.3",
    "argon2": "0.45.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "ioredis": "5.11.1",
    "jose": "6.2.12",
    "next": "15.5.27",
    "nodemailer": "10.0.15",
    "pg": "8.23.1",
    "radix-ui": "1.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.89.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/eslintrc": "3.3.1",
    "@material-symbols/svg-400": "0.47.6",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "postcss": "8.5.29",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
